<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="scanrift.db" />
        <include domain="database" path="scanrift.db-wal" />
        <include domain="database" path="scanrift.db-shm" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="scanrift.db" />
        <include domain="database" path="scanrift.db-wal" />
        <include domain="database" path="scanrift.db-shm" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
